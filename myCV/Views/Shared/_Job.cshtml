@model IEnumerable<Job>
@{
    string lang = ViewContext.RouteData.Values["lang"]?.ToString() ?? "en";
    string title = lang == "pl" ? "Doœwiadczenie zawodowe" : "Work experience";
}
<div id="job" class="pageElement">
    <h1 class="text-center">@title</h1>
    <ul>
        @foreach (var item in Model)
        {
            <li>
                <h3>@item.getCompanyName()</h3>
                <p>@item.getPositionName(lang)</p>
                <p>@item.getStartDate() - @item.getEndDate(lang)</p>
                <p style="white-space: pre-wrap;">@item.getDescription(lang)</p>
            </li>
        }
    </ul>
</div>