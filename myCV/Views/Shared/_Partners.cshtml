@{
    string lang = ViewContext.RouteData.Values["lang"]?.ToString() ?? "en";
    string title = lang == "pl" ? "Partnerzy" : "Partners";
}
<div class="pageElement">
    <div id="partners">
        <h1 class="text-center">@title</h1>
        <div class="partner-logo">
            <a href="https://www.euvic.com/pl/" target="_blank" rel="noopener noreferrer">
                <img src="~/img/logoEuvic.png" alt="PL"/>
            </a>
        </div>
        <div class="partner-logo">
            <a href="https://www.hl-display.com/pl/" target="_blank" rel="noopener noreferrer">
                <img src="~/img/logoHL.png" alt="PL"/>
            </a>
        </div>
        @* <a href="https://www.arh-plus.pl/pl" target="_blank" rel="noopener noreferrer">ARH Plus</a> *@
    </div>
</div>