@model IEnumerable<Hobby>
@{
    string lang = ViewContext.RouteData.Values["lang"]?.ToString() ?? "en";
    string title = lang == "pl" ? "Zainteresowania" : "Hobbies";
}
<div id="hobby" class="pageElement">
    <h1 class="text-center">@title</h1>
    <ul>
        @foreach (var item in Model)
        {
            <li>
                <span>@item.getName(lang) - @item.getDescription(lang)</span>
            </li>
        }
    </ul>
</div>