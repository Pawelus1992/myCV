@using System.Collections.Generic
@using myCV.Models
@{
    string lang = ViewContext.RouteData.Values["lang"]?.ToString() ?? "en";
    ViewData["Title"] = lang == "pl" ? "Witaj" : "Welcome";

    var jobList = ViewData["JobList"] as IEnumerable<Job>;
    var educationList = ViewData["EducationList"] as IEnumerable<Education>;
    var hobbyList = ViewData["HobbyList"] as IEnumerable<Hobby>;
}
<div class="container">
    @await Html.PartialAsync("_Intro")
    @await Html.PartialAsync("_Job", jobList)
    @await Html.PartialAsync("_Education", educationList)
    @await Html.PartialAsync("_Skill")
    @await Html.PartialAsync("_Project")
    @await Html.PartialAsync("_Hobby", hobbyList)
    @await Html.PartialAsync("_Contact")
    @await Html.PartialAsync("_Partners")
</div>